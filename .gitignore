# OpenTrader — .gitignore

# Secrets & credentials
config/alt_data_keys.json
*.pem
*.key
.env
data/connections.json

# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.venv/
venv/

# Logs & runtime
logs/
*.log
*.log.*
*.jsonl

# Model & large data (archived to ~/opentrader-data/)
*.bin
*.safetensors
*.pth
*.pt
*.ckpt
*.h5
*.gguf
unsloth_compiled_cache/
_unsloth_sentencepiece_temp/

# IDE & tools
.vscode/
.idea/
.ruff_cache/
.codesage/
.documents/

# OpenCode / Claude / AI tooling
.opencode/
.claude/

# OS noise
.DS_Store
Thumbs.db

# Runtime caches & churn (audit F7 / push-readiness)
*.db
*.db-shm
*.db-wal
data/research/
data/backups/
data/history/
data/fast_test/
*.bak.*

# Arena runtime artifacts (regenerated each iteration; commit only small state)
data/arena/arena_state.json
data/arena/arena_snapshot.html
data/arena/arena_view.html
data/arena/relabels.json
data/arena/run_status.json
data/gpu_scheduler/*.out

# Rust build artifacts
exchange-engine/target/
exchange_engine/
*.bak
data/paper_state.json.synthetic-era-bak
*.bak-*
*.pkl
data/shadow_aab/
data/arxiv_library.json
OpenTrader/
