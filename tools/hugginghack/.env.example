# Host port for the HuggingHack web UI.
HUGGINGHACK_PORT=7860

# Desktop default. On your NAS, replace this with an absolute host path such as:
# /volume1/AI/models
# /mnt/tank/ai/models
# /share/Container/models
MODEL_STORAGE_PATH=./models

# Optional. Use a READ token for private or gated repositories.
HF_TOKEN=
HF_ENDPOINT=https://huggingface.co
MAX_CONCURRENT_DOWNLOADS=2
DOWNLOAD_WORKERS_PER_JOB=4
PUID=0
PGID=0

